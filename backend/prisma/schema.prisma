// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Concept {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   @default("idea") // idea, theory, question, quote, term, etc
  createdBy   String   @default("anonymous")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships where this concept is the source
  outgoingRelationships Relationship[] @relation("SourceConcept")
  // Relationships where this concept is the target
  incomingRelationships Relationship[] @relation("TargetConcept")

  @@index([type])
  @@index([createdAt])
}

model Relationship {
  id               String   @id @default(uuid())
  sourceConceptId  String
  targetConceptId  String
  relationshipType String   // influences, contradicts, evolves_from, example_of, etc
  description      String?  // optional context for the relationship
  createdBy        String   @default("anonymous")
  createdAt        DateTime @default(now())

  sourceConcept Concept @relation("SourceConcept", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept Concept @relation("TargetConcept", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@index([relationshipType])
}
